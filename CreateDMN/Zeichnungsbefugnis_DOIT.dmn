        <outputEntry id="Rule_VG_5_Out1"><text>"AL"</text></outputEntry>
        <outputEntry id="Rule_VG_5_Out2"><text>""</text></outputEntry>
        <outputEntry id="Rule_VG_5_Out3"><text>"§ 18 Abs. 2 ZO"</text></outputEntry>
      </rule>
      <rule id="Rule_VG_6">
        <description>Über 190.000 EUR: außerhalb der Zeichnungsbefugnis DO.IT</description>
        <inputEntry id="Rule_VG_6_In1"><text></text></inputEntry>
        <outputEntry id="Rule_VG_6_Out1"><text>"Keine Zeichnungsbefugnis DO.IT (höhere Zuständigkeit)"</text></outputEntry>
        <outputEntry id="Rule_VG_6_Out2"><text>""</text></outputEntry>
        <outputEntry id="Rule_VG_6_Out3"><text>"§ 18 Abs. 2 ZO"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>

  <!-- § 25 Abs. 4 ZO: Leistung von Vorauszahlungen -->
