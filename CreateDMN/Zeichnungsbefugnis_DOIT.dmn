        <outputEntry id="Rule_IT_6_Out3"><text>"§ 29 Abs. 7 ZO"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>

  <!-- § 20 Abs. 1 ZO: Anmietung beweglicher Gegenstände, Vertragsdauer bis 5 Jahre -->
  <decision id="Decision_Anmietung" name="Anmietung beweglicher Gegenstände">
    <decisionTable id="DecisionTable_Anmietung" hitPolicy="FIRST">
      <input id="Input_AM_Dauer" label="Vertragsdauer (Jahre)" camunda:inputVariable="vertragsdauerJahre">
        <inputExpression id="InputExpression_AM_Dauer" typeRef="integer">
          <text>vertragsdauerJahre</text>
        </inputExpression>
      </input>
      <input id="Input_AM_Betrag" label="Jährlicher Mietwert je Gegenstand (EUR)" camunda:inputVariable="betrag">
        <inputExpression id="InputExpression_AM_Betrag" typeRef="double">
          <text>betrag</text>
        </inputExpression>
      </input>
      <output id="Output_AM_Ebene" label="Zeichnungsbefugte Ebene" name="ebene" typeRef="string" />
      <output id="Output_AM_Einvernehmen" label="Einvernehmen" name="einvernehmen" typeRef="string" />
      <output id="Output_AM_Grundlage" label="Rechtsgrundlage" name="rechtsgrundlage" typeRef="string" />
      <rule id="Rule_AM_1">
        <description>Vertragsdauer über 5 Jahre: außerhalb der Zeichnungsbefugnis DO.IT</description>
        <inputEntry id="Rule_AM_1_In1"><text>&gt; 5</text></inputEntry>
        <inputEntry id="Rule_AM_1_In2"><text></text></inputEntry>
        <outputEntry id="Rule_AM_1_Out1"><text>"Keine Zeichnungsbefugnis DO.IT (höhere Zuständigkeit)"</text></outputEntry>
        <outputEntry id="Rule_AM_1_Out2"><text>""</text></outputEntry>
        <outputEntry id="Rule_AM_1_Out3"><text>"§ 20 Abs. 1 ZO"</text></outputEntry>
      </rule>
      <rule id="Rule_AM_2">
        <description>Bis 10.000 EUR: TL</description>
        <inputEntry id="Rule_AM_2_In1"><text></text></inputEntry>
        <inputEntry id="Rule_AM_2_In2"><text>&lt;= 10000</text></inputEntry>
        <outputEntry id="Rule_AM_2_Out1"><text>"TL"</text></outputEntry>
        <outputEntry id="Rule_AM_2_Out2"><text>""</text></outputEntry>
        <outputEntry id="Rule_AM_2_Out3"><text>"§ 20 Abs. 1 ZO"</text></outputEntry>
      </rule>
      <rule id="Rule_AM_3">
        <description>Bis 20.000 EUR: Sachgebietsleitung</description>
        <inputEntry id="Rule_AM_3_In1"><text></text></inputEntry>
        <inputEntry id="Rule_AM_3_In2"><text>&lt;= 20000</text></inputEntry>
        <outputEntry id="Rule_AM_3_Out1"><text>"SGL"</text></outputEntry>
        <outputEntry id="Rule_AM_3_Out2"><text>""</text></outputEntry>
        <outputEntry id="Rule_AM_3_Out3"><text>"§ 20 Abs. 1 ZO"</text></outputEntry>
      </rule>
      <rule id="Rule_AM_4">
        <description>Bis 30.000 EUR: Abteilungsleitung</description>
        <inputEntry id="Rule_AM_4_In1"><text></text></inputEntry>
        <inputEntry id="Rule_AM_4_In2"><text>&lt;= 30000</text></inputEntry>
        <outputEntry id="Rule_AM_4_Out1"><text>"AbtL"</text></outputEntry>
        <outputEntry id="Rule_AM_4_Out2"><text>""</text></outputEntry>
        <outputEntry id="Rule_AM_4_Out3"><text>"§ 20 Abs. 1 ZO"</text></outputEntry>
      </rule>
      <rule id="Rule_AM_5">
        <description>Bis 50.000 EUR: Amtsleitung</description>
        <inputEntry id="Rule_AM_5_In1"><text></text></inputEntry>
        <inputEntry id="Rule_AM_5_In2"><text>&lt;= 50000</text></inputEntry>
        <outputEntry id="Rule_AM_5_Out1"><text>"AL"</text></outputEntry>
        <outputEntry id="Rule_AM_5_Out2"><text>""</text></outputEntry>
        <outputEntry id="Rule_AM_5_Out3"><text>"§ 20 Abs. 1 ZO"</text></outputEntry>
      </rule>
      <rule id="Rule_AM_6">
        <description>Über 50.000 EUR: außerhalb der Zeichnungsbefugnis DO.IT</description>
        <inputEntry id="Rule_AM_6_In1"><text></text></inputEntry>
        <inputEntry id="Rule_AM_6_In2"><text></text></inputEntry>
        <outputEntry id="Rule_AM_6_Out1"><text>"Keine Zeichnungsbefugnis DO.IT (höhere Zuständigkeit)"</text></outputEntry>
        <outputEntry id="Rule_AM_6_Out2"><text>""</text></outputEntry>
        <outputEntry id="Rule_AM_6_Out3"><text>"§ 20 Abs. 1 ZO"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>

