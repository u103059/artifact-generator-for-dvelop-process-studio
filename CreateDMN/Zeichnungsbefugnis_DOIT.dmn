      <rule id="Rule_VG_4">
        <description>Bis 120.000 EUR: Abteilungsleitung</description>
        <inputEntry id="Rule_VG_4_In1"><text>&lt;= 120000</text></inputEntry>
        <outputEntry id="Rule_VG_4_Out1"><text>"AbtL"</text></outputEntry>
        <outputEntry id="Rule_VG_4_Out2"><text>""</text></outputEntry>
        <outputEntry id="Rule_VG_4_Out3"><text>"§ 18 Abs. 2 ZO"</text></outputEntry>
      </rule>
      <rule id="Rule_VG_5">
        <description>Bis 190.000 EUR: Amtsleitung</description>
