        <outputEntry id="Rule_VZ_5_Out2"><text>"Stadtkämmerei und Rechtsamt"</text></outputEntry>
        <outputEntry id="Rule_VZ_5_Out3"><text>"§ 25 Abs. 4 ZO"</text></outputEntry>
      </rule>
      <rule id="Rule_VZ_6">
        <description>Über 190.000 EUR: außerhalb der Zeichnungsbefugnis DO.IT</description>
