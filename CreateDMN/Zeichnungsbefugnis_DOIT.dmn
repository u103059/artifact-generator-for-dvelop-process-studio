<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/"
             xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/"
             xmlns:camunda="http://camunda.org/schema/1.0/dmn"
             id="Definitions_Zeichnungsbefugnis_DOIT"
             name="Zeichnungsbefugnis DO.IT"
             namespace="http://camunda.org/schema/1.0/dmn"
             exporter="Camunda Modeler"
             exporterVersion="5.0.0">

  <!-- § 18 Abs. 1 ZO: Entscheidung über Art und Umfang der Beschaffung -->
  <decision id="Decision_Beschaffung_Art_Umfang" name="Beschaffung Art und Umfang">
    <decisionTable id="DecisionTable_Beschaffung_Art_Umfang" hitPolicy="FIRST">
      <input id="Input_BAU_Betrag" label="Voraussichtlicher Aufwand (EUR)" camunda:inputVariable="betrag">
        <inputExpression id="InputExpression_BAU_Betrag" typeRef="double">
          <text>betrag</text>
        </inputExpression>
      </input>
      <output id="Output_BAU_Ebene" label="Zeichnungsbefugte Ebene" name="ebene" typeRef="string" />
      <output id="Output_BAU_Einvernehmen" label="Einvernehmen" name="einvernehmen" typeRef="string" />
      <output id="Output_BAU_Grundlage" label="Rechtsgrundlage" name="rechtsgrundlage" typeRef="string" />
      <rule id="Rule_BAU_1">
        <description>Bis 20.000 EUR: Sachbearbeitung</description>
        <inputEntry id="Rule_BAU_1_In1"><text>&lt;= 20000</text></inputEntry>
        <outputEntry id="Rule_BAU_1_Out1"><text>"SB"</text></outputEntry>
        <outputEntry id="Rule_BAU_1_Out2"><text>""</text></outputEntry>
        <outputEntry id="Rule_BAU_1_Out3"><text>"§ 18 Abs. 1 ZO"</text></outputEntry>
      </rule>
      <rule id="Rule_BAU_2">
        <description>Bis 40.000 EUR: TL</description>
        <inputEntry id="Rule_BAU_2_In1"><text>&lt;= 40000</text></inputEntry>
        <outputEntry id="Rule_BAU_2_Out1"><text>"TL"</text></outputEntry>
        <outputEntry id="Rule_BAU_2_Out2"><text>""</text></outputEntry>
        <outputEntry id="Rule_BAU_2_Out3"><text>"§ 18 Abs. 1 ZO"</text></outputEntry>
      </rule>
      <rule id="Rule_BAU_3">
        <description>Bis 80.000 EUR: Sachgebietsleitung</description>
        <inputEntry id="Rule_BAU_3_In1"><text>&lt;= 80000</text></inputEntry>
        <outputEntry id="Rule_BAU_3_Out1"><text>"SGL"</text></outputEntry>
        <outputEntry id="Rule_BAU_3_Out2"><text>""</text></outputEntry>
        <outputEntry id="Rule_BAU_3_Out3"><text>"§ 18 Abs. 1 ZO"</text></outputEntry>
      </rule>
      <rule id="Rule_BAU_4">
        <description>Bis 120.000 EUR: Abteilungsleitung</description>
        <inputEntry id="Rule_BAU_4_In1"><text>&lt;= 120000</text></inputEntry>
        <outputEntry id="Rule_BAU_4_Out1"><text>"AbtL"</text></outputEntry>
        <outputEntry id="Rule_BAU_4_Out2"><text>""</text></outputEntry>
        <outputEntry id="Rule_BAU_4_Out3"><text>"§ 18 Abs. 1 ZO"</text></outputEntry>
      </rule>
      <rule id="Rule_BAU_5">
        <description>Bis 190.000 EUR: Amtsleitung</description>
        <inputEntry id="Rule_BAU_5_In1"><text>&lt;= 190000</text></inputEntry>
        <outputEntry id="Rule_BAU_5_Out1"><text>"AL"</text></outputEntry>
        <outputEntry id="Rule_BAU_5_Out2"><text>""</text></outputEntry>
        <outputEntry id="Rule_BAU_5_Out3"><text>"§ 18 Abs. 1 ZO"</text></outputEntry>
      </rule>
      <rule id="Rule_BAU_6">
        <description>Über 190.000 EUR: außerhalb der Zeichnungsbefugnis DO.IT</description>
        <inputEntry id="Rule_BAU_6_In1"><text></text></inputEntry>
        <outputEntry id="Rule_BAU_6_Out1"><text>"Keine Zeichnungsbefugnis DO.IT (höhere Zuständigkeit)"</text></outputEntry>
        <outputEntry id="Rule_BAU_6_Out2"><text>""</text></outputEntry>
        <outputEntry id="Rule_BAU_6_Out3"><text>"§ 18 Abs. 1 ZO"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>

  <!-- § 18 Abs. 2 ZO: Entscheidung über die Vergabe von Lieferungen und Leistungen -->
  <decision id="Decision_Vergabe" name="Vergabe von Lieferungen und Leistungen">
