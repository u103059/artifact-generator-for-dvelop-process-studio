        <outputEntry id="Rule_IT_5_Out3"><text>"§ 29 Abs. 7 ZO"</text></outputEntry>
      </rule>
      <rule id="Rule_IT_6">
        <description>Über 190.000 EUR: außerhalb der Zeichnungsbefugnis DO.IT</description>
        <inputEntry id="Rule_IT_6_In1"><text></text></inputEntry>
        <outputEntry id="Rule_IT_6_Out1"><text>"Keine Zeichnungsbefugnis DO.IT (höhere Zuständigkeit)"</text></outputEntry>
