<?xml version="1.0" encoding="UTF-8"?>
<dmn:definitions xmlns:dmn="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" id="b-3f9a1c62-7b4e-4d85-9a21-c6e0b5d84f17" name="Betrag zu Zeichnungsbefugnis" namespace="http://camunda.org/schema/1.0/dmn" exporter="d.velop process modeler" exporterVersion="1.1.0">
  <dmn:decision id="b-3f9a1c62-7b4e-4d85-9a21-c6e0b5d84f17-root" name="Main">
    <dmn:decisionTable id="mainTable" hitPolicy="FIRST">
      <dmn:input id="input" label="Betrag_EUR" camunda:inputVariable="input">
        <dmn:inputExpression id="inputExpression" typeRef="Number">
          <dmn:text></dmn:text>
        </dmn:inputExpression>
      </dmn:input>
      <dmn:output id="output" label="Zeichnungsbefugnis" name="output" typeRef="String" />
      <dmn:rule id="DecisionRule_4kq8w1n">
        <dmn:inputEntry id="UnaryTests_9d2xv7b">
          <dmn:text>&lt;= 20000</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="LiteralExpression_2h6tr0c">
          <dmn:text>"SB"</dmn:text>
        </dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="DecisionRule_7m3zc5e">
        <dmn:inputEntry id="UnaryTests_5p1yj8k">
          <dmn:text>&lt;= 40000</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="LiteralExpression_8a4nf3q">
          <dmn:text>"TL"</dmn:text>
        </dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="DecisionRule_1v9hb6s">
        <dmn:inputEntry id="UnaryTests_3r7ke2u">
          <dmn:text>&lt;= 80000</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="LiteralExpression_6w0dg9x">
          <dmn:text>"SGL"</dmn:text>
        </dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="DecisionRule_0c5qa4j">
        <dmn:inputEntry id="UnaryTests_7t8mz1f">
          <dmn:text>&lt;= 120000</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="LiteralExpression_4y2lp5h">
          <dmn:text>"AbtL"</dmn:text>
        </dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="DecisionRule_8e6ux3d">
        <dmn:inputEntry id="UnaryTests_1n4bv9w">
          <dmn:text>&lt;= 190000</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="LiteralExpression_9s3cr7m">
          <dmn:text>"AL"</dmn:text>
        </dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="DecisionRule_2j7gt0y">
        <dmn:inputEntry id="UnaryTests_6f5hq2z">
          <dmn:text></dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="LiteralExpression_0b8wk4v">
          <dmn:text>"Keine Zeichnungsbefugnis im Amt"</dmn:text>
        </dmn:outputEntry>
      </dmn:rule>
    </dmn:decisionTable>
  </dmn:decision>
  <dmndi:DMNDI>
    <dmndi:DMNDiagram>
      <dmndi:DMNShape dmnElementRef="b-3f9a1c62-7b4e-4d85-9a21-c6e0b5d84f17-root">
